{
  "name": "domain-harness-monorepo",
  "version": "0.11.1",
  "private": true,
  "workspaces": [
    "packages/domain-harness"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@kaicreator/domain-harness",
    "typecheck": "npm run typecheck --workspace=@kaicreator/domain-harness",
    "lint": "node scripts/check-source-quality.mjs && eslint .",
    "test:generation": "node --test scripts/tests/native-generation.test.mjs && node scripts/validate-native-generation.mjs --manifest examples/native-domain-app/package.json --core examples/native-domain-app/packages/kdp.mjs --core examples/native-domain-app/packages/business.mjs --core examples/native-domain-app/packages/workflow-init.mjs",
    "test": "npm run test:typecheck --workspace=@kaicreator/domain-harness && node --import tsx --test packages/domain-harness/tests/core/*.test.ts && npm run test:generation && npm run test:regression",
    "test:demo": "node examples/native-domain-app/main.mjs",
    "test:consumer": "node scripts/verify-native-sdk-clean-install.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run test:demo && npm run test:consumer",
    "test:regression": "node --test scripts/tests/native-stage-regression.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}

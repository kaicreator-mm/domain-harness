{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.8 internal research candidate operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "inputSchema",
    "outputSchema",
    "failures",
    "effect",
    "callers",
    "exposure"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$"
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$"
      },
      "uniqueItems": true
    },
    "effect": {
      "enum": [
        "none",
        "idempotent",
        "non-idempotent"
      ]
    },
    "callers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$"
      }
    },
    "exposure": {
      "enum": [
        "host",
        "component",
        "internal"
      ]
    }
  }
}

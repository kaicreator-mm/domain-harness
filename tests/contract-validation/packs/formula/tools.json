    "outputSchema": {
      "type": "object",
      "required": ["recorded", "reviewId", "verdict"],
      "properties": {
        "recorded": { "type": "boolean" },
        "reviewId": { "type": "string" },
        "verdict": { "type": "string", "enum": ["certified", "needs_work"] }
      }
    }
  },

        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"
      },
      "messageId": "exec:77a1:timeout",
      "type": "GenerationObserved",
      "payload": {
        "status": "TIMEOUT",
        "commandId": "obs_1"
      }
    },
    {
      "action": "settle"
    },
    {
      "action": "expect-instance",
      "target": {
        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"

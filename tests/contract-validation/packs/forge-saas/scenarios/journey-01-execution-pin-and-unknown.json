      "messageId": "cmd_pub_1",
      "type": "RequestPublish",
      "payload": {
        "commandId": "cmd_pub_1"
      }
    },
    {
      "action": "settle"
    },
    {
      "action": "expect-instance",
      "target": {
        "workflowId": "forge.page",
        "instanceKey": "page_furniture_th_01"
      },
      "expect": {
        "lastResult": {
          "outcome": "applied",
          "rescheduledToSlot": "2026-09-21"
        }
      }
    },
    {
      "action": "finding",
      "id": "throttle-reschedules-not-fails",
      "severity": "info",
      "summary": "发布节流超限不失败：自动排期下一槽位并延迟重入队（红线#2）——映射为 applied(rescheduled) 而非 rejected；[G6] 持久定时器承接延迟重入队。"
    },
    {
      "action": "restart"
    },
    {
      "action": "expect-instance",
      "target": {
        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"

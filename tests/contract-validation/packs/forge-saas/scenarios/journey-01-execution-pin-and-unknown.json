    {
      "action": "finding",
      "id": "unknown-is-first-class",
      "severity": "divergence",
      "summary": "TIMEOUT→UNKNOWN 是合法驻留态（可能已计费）：绝不映射 failed/success，只经 reconcile probe 的决定性证据收敛，结构上无 blind retry。当前 SDK 的 disposition 词表（processed/failed/abandoned）没有 unknown 驻留语义——v0.3 effect/journal 设计应把「语义不明」建为一等公民（Cairn RECOVERY_REQUIRED、Audio paid_retry_policy、Tally UNCERTAIN 同族证据）。",
      "related": "分析文档 §3.5 / v0.3 PRD §14"
    },
    {
      "action": "send",
      "to": {
        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"
      },
      "messageId": "reconcile:inv_gen_501:SUCCESS",
      "type": "ReconciliationResolved",
      "payload": {

      "to": {
        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"
      },
      "messageId": "restore:execution:77a1",
      "type": "Restore",
      "payload": {
        "snapshot": {
          "pin": "trade-site-harness-v2952-r7"
        }
      }
    },
    {
      "action": "settle"
    },
    {
      "action": "expect-instance",
      "target": {
        "workflowId": "forge.execution",
        "instanceKey": "tenant_myanmar_teak-generation-fp_v28_77a1"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/domain-harness/dis/0.1.0/composition-graph.schema.json",
  "title": "DIS 0.1.0 Composition Graph (initial draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "entryNode", "nodes", "edges", "terminalNodes"],
  "properties": {
    "schemaVersion": { "const": "dis.graph/0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "entryNode": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["nodeId", "unitRef"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "unitRef": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "revision"],
            "properties": { "id": { "type": "string" }, "revision": { "type": "string" }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "when": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "operator", "value"],
            "properties": { "path": { "type": "string" }, "operator": { "enum": ["equals", "notEquals", "exists"] }, "value": {} }
          },
          "map": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["from", "to"],
              "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
            }
          }
        }
      }
    },
    "terminalNodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  }
}

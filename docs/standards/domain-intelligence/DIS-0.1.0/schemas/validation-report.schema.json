{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/domain-harness/dis/0.1.0/validation-report.schema.json",
  "title": "DIS 0.1.0 Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "standard",
    "demo",
    "environment",
    "command",
    "result",
    "tests",
    "findings",
    "validatedAt",
    "subject",
    "dependencyClosure",
    "profile",
    "validator",
    "baseline",
    "coverage"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision"
      ],
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "platform"
      ],
      "properties": {
        "runtime": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "PASS_WITH_FINDINGS",
        "BLOCK",
        "NOT_RUN"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "EXPECTED_GAP",
              "NOT_RUN"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "description": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "dataset", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["positive", "negative", "boundary", "ambiguous", "out_of_scope"] },
          "dataset": { "enum": ["AUTHORING", "HELD_OUT"] },
          "result": { "enum": ["PASS", "FAIL", "NOT_RUN"] }
        }
      }
    },
    "counterexamples": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unit",
            "knowledge",
            "rule",
            "graph",
            "package"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "resources"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "boundary",
        "heldOut"
      ],
      "properties": {
        "positive": {
          "type": "integer",
          "minimum": 0
        },
        "negative": {
          "type": "integer",
          "minimum": 0
        },
        "boundary": {
          "type": "integer",
          "minimum": 0
        },
        "heldOut": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

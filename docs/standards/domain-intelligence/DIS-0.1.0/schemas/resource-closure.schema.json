{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaicreator-mm.github.io/domain-harness/dis/0.1.0/resource-closure.schema.json",
  "title": "DIS 0.1.0 Complete Package Resource Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageRevision",
    "standardVersion",
    "definitionRef",
    "graphRef",
    "units",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dis.resource-closure/0.1.0"
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "packageRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)$"
    },
    "standardVersion": {
      "const": "0.1.0"
    },
    "definitionRef": {
      "$ref": "#/$defs/identityPathRef"
    },
    "graphRef": {
      "$ref": "#/$defs/identityPathRef"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unitPathRef"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "packageRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)(?:\\\\.|\\\\.\\\\.)(?:/|$))(?!.*//)(?!.*\\\\\\\\)[A-Za-z0-9._/-]+$"
    },
    "identityPathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)$"
        },
        "path": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    },
    "unitPathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)$"
        },
        "path": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "kind",
        "owners",
        "required"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/packageRelativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "unit",
            "graph",
            "definition",
            "schema",
            "fixture",
            "implementation",
            "conformance"
          ]
        },
        "owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}

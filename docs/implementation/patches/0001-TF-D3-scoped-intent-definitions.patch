From 3ce11180c5175e40dbe425dbe6774aff4e9875cc Mon Sep 17 00:00:00 2001
From: kaicreator-mm <bba287191@gmail.com>
Date: Mon, 12 Oct 2026 10:36:12 +0800
Subject: [PATCH] fix(v0.8 T-F D3): scope each engineering intent to its own
 rule-authorized definition (#1005)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause (RED evidence vs PR #1012@9f6aaf4): wireAdmissionEffectBindings
(kernel-mechanism-v1.mjs:1376) validates binding.definition ??
workflowDefinition as ONE unit against each binding's own rule
projection, so the shared three-stage workflow's dynamic evidence
declarations were rejected against every foreign stage rule
(ADMISSION_EFFECT_BINDING_INVALID at createOccurrenceRuntime) — the
package could not be installed by the real current Kernel, and the
public DomainHarness.load facade would fail the same way.

Minimal fix following the Kernel's established authoring pattern
(V08-ABI-C01 fixture, Approval package): each intent binding carries a
scoped definition clone in which only its OWN transition keeps the
dynamic evidence binding; other transitions keep identical
triggers/guards/targets with empty effectIntents (never selectable for
this binding's trigger anyway). Shared workflowDefinition, guards,
rules, roles, effect handler and idempotency templates unchanged;
F01 structural assertions still pass unchanged.

12/12 v08-tf-d3 tests green; compiler suite 256/256; F01 6/6.
---
 .../v08-domain-apps/business-engineering.mjs  | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/examples/v08-domain-apps/business-engineering.mjs b/examples/v08-domain-apps/business-engineering.mjs
index 8467951..6a3b8ba 100644
--- a/examples/v08-domain-apps/business-engineering.mjs
+++ b/examples/v08-domain-apps/business-engineering.mjs
@@ -112,6 +112,25 @@ const workflowDefinition = {
   ],
 };
 
+// The Kernel wires each intent binding's effect declarations against THAT
+// binding's own rule projection (wireAdmissionEffectBindings validates
+// `binding.definition ?? workflowDefinition` as one unit), so a multi-stage
+// shared workflow must hand every intent a definition in which only its OWN
+// transition carries the dynamic evidence binding — the same authoring
+// pattern as the Approval package's dynamic binding. The shared
+// workflowDefinition above stays the declared lifecycle contract; each
+// scoped clone keeps every state and guard so the state machine and denial
+// paths are identical.
+function scopedDefinition(transitionKey) {
+  const definition = structuredClone(workflowDefinition);
+  for (const state of definition.states) {
+    for (const transition of state.transitions ?? []) {
+      if (transition.transitionKey !== transitionKey) transition.effectIntents = [];
+    }
+  }
+  return definition;
+}
+
 export function getPolicy() {
   return {
     packageId: MODULE_ID,
@@ -140,14 +159,17 @@ export function getPolicy() {
       reviewChange: {
         trigger: { kind: 'event', eventType: 'CHANGE_REVIEWED' },
         ruleId: 'rule:review-change', roles: ['reviewer'],
+        definition: scopedDefinition('review'),
       },
       recordValidation: {
         trigger: { kind: 'event', eventType: 'VALIDATION_PASSED' },
         ruleId: 'rule:record-validation', roles: ['validator'],
+        definition: scopedDefinition('validate'),
       },
       qualifyRelease: {
         trigger: { kind: 'event', eventType: 'RELEASE_QUALIFIED' },
         ruleId: 'rule:qualify-release', roles: ['release-manager'],
+        definition: scopedDefinition('qualify'),
       },
     },
     effectBindings: {

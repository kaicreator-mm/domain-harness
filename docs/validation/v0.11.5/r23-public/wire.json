    },
    "continuation": {
      "model": "fixture-model",
      "messages": [
        {
          "role": "system",
          "content": "Use only current authorized offer observations."
        },
        {
          "role": "user",
          "content": "Compare A and B for six compatible units."
        },
        {
          "role": "assistant",
          "content": null,
          "tool_calls": [
            {
              "id": "call-A",

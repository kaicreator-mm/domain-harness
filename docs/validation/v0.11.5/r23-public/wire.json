  "assertions": {
    "wire": "compare parsed JSON structure and exact frozen request bytes used for token bound versus HTTP body; property order not an independent business criterion; assistant accepted prior wire order and result IDs exact; all results prior to reentry",
    "expectedUsage": {
      "openaiInitial": {
        "input": 90,
        "output": 12,
        "total": 102
      },
      "anthropicInitial": {
        "input": 95,
        "output": 12,
        "total": 107
      },
      "missingAnthropicCache": "unknown input total unless profile establishes absent means zero"
    },
    "actualResult": "lead=2 is a bounded schema-valid suggestion, not source authority; verify DA optimum against actual data independently"
  },
  "negative": [
    {
      "id": "wire-id-duplicate",
      "mutate": "second call id=call-A",
      "expect": "non-COMPLETE, no tool execution"
    },
    {
      "id": "wire-id-foreign",
      "mutate": "result callId=foreign",
      "expect": "continuation HTTP delta0"
    },
    {
      "id": "wire-id-incomplete",
      "mutate": "omit second result",
      "expect": "continuation HTTP delta0"
    },
    {
      "id": "wire-id-reorder",
      "mutate": "swap result order",
      "expect": "Reject wrong supplied result order before HTTP; normalized outgoing order must equal exact original accepted call order."
    },
    {
      "id": "wire-args",
      "mutate": "OpenAI arguments raw string {bad",
      "expect": "non-COMPLETE"
    },
    {
      "id": "wire-json-duplicate",
      "raw": "{\"lead\":2,\"lead\":3}",
      "expect": "non-COMPLETE"
    },
    {
      "id": "wire-json-prototype",
      "raw": "{\"__proto__\":{},\"lead\":2}",
      "expect": "non-COMPLETE"
    },
    {
      "id": "wire-json-shape",
      "raw": "{\"lead\":\"2\"}",
      "expect": "non-COMPLETE"
    },
    {
      "id": "wire-schema",
      "mutate": "strict true missing schema or $ref recursion or additionalProperties not false or unsupported tools+schema profile",
      "expect": "credential and HTTP delta0"
    },
    {
      "id": "wire-reject",
      "mutate": "OpenAI refusal/content_filter/length or Anthropic refusal/max_tokens/pause_turn/unknown block",
      "expect": "non-COMPLETE; no invented output"
    },
    {
      "id": "wire-http",
      "statuses": [
        401,
        403,
        429,
        500,
        503
      ],
      "expect": "stable redacted non-success; no automatic retry"
    },
    {
      "id": "wire-redirect",
      "status": 302,
      "location": "/target",
      "expect": "target hit0 and no forwarded credentials"
    },
    {
      "id": "wire-cap",
      "bodyBytes": 4097,
      "expect": "bounded read/cancel, no parse/adoption"
    },
    {
      "id": "wire-utf8",
      "hex": "c328",
      "expect": "fatal UTF-8 failure"
    },
    {
      "id": "wire-timeout",
      "delayMs": 1500,
      "expect": "actual abort/non-COMPLETE, no late result accepted"
    },
    {
      "id": "wire-credential-cancel",
      "barrier": "credential pending then abort",
      "expect": "HTTP delta0; local quiescence before scope release"
    },
    {
      "id": "wire-credential-stale",
      "barrier": "credential pending then bound ancestor frame r1->r2 or auth revoke",
      "expect": "HTTP delta0"
    },
    {
      "id": "wire-late",
      "barrier": "after actual HTTP before body adoption change epoch",
      "expect": "no proposal adoption, actual usage/attempt retained"
    },
    {
      "id": "wire-usage",
      "mutate": "OpenAI total inconsistent with input/output, negative/noninteger or output33 beyond32",
      "expect": "protocol/limit failure, retain actual facts"
    },
    {
      "id": "wire-retry",
      "mutate": "explicit same key after failure then fallback, success reclassified as retry, foreign turn",
      "expect": "only authorized eligible retry/fallback increment same attempt and shared counters, successful reclassification/foreign turn deny"
    },
    {
      "id": "wire-budget",
      "aggregate": 319,
      "expect": "first actual request may consume160, second zero credential/HTTP; no refund"
    },
    {
      "id": "wire-depth",
      "depth": 33,
      "expect": "bounded reject before unbounded construction"
    }
  ]
}

{
  "format": "dh-r23-public-wire/1",
  "status": "NOT_RUN",
  "classification": "PUBLIC_LOOPBACK_FIXTURES_NOT_PROVIDER_QUALIFICATION",
  "profile": {
    "explicitLoopback": true,
    "requestBytes": 4096,
    "responseBytes": 4096,
    "maxOutputTokens": 32,
    "timeoutMs": 1000,
    "features": [
      "tools",
      "jsonSchema",
      "toolsWithJsonSchema"
    ],
    "tokenBoundFixtureOnly": {
      "inputUpperBound": 128,
      "output": 32,
      "aggregateExactTwoCalls": 320,
      "aggregateOneShort": 319,
      "assertion": "trusted test handler enforces declared bound; second credential and HTTP zero for 319; live profile must separately demonstrate reliable bound"
    }
  },
  "openai": {

{
  "schemaVersion": "dis.unit/0.1.0",
  "id": "xdownload.player.bounded-fallback",
  "revision": "1.0.0",
  "role": "procedure",
  "purpose": "Return a bounded clarification or review outcome when recognition is ambiguous or unknown.",
  "scope": {
    "domain": "web-media",
    "appliesTo": [
      "ambiguous-or-unknown-player-recognition"
    ],
    "excludes": [
      "automatic-player-guessing",
      "download-execution"
    ]
  },
  "owner": "xdownload-demo",
  "authority": "CONTROLLED",
  "qualification": {
    "profile": "xdownload.player.bounded-fallback.qualification/0.1.0",
    "limitations": [
      "No LLM call; emits a bounded handoff."
    ]
  },
  "input": {
    "schemaRef": "domain/schemas/resolve-input.schema.json"
  },
  "output": {
    "schemaRef": "domain/schemas/resolution.schema.json"
  },
  "implementation": {
    "strategy": "function",
    "ref": "registry:xdownload.player.bounded-fallback@1.0.0",
    "exposure": "private",
    "artifactRef": "src/runner.mjs"
  },
  "evidence": {
    "sources": [
      {
        "sourceId": "fallback-policy",
        "kind": "authority",
        "ref": "domain/units/decision.json",
        "claim": "Unknown and ambiguous recognition must not be silently promoted."
      }
    ],
    "absenceReason": null
  },
  "failure": {
    "handling": {
      "AMBIGUOUS": {
        "action": "WAIT",
        "reason": "Declared AMBIGUOUS handling for the reference Consumer."
      },
      "UNKNOWN": {
        "action": "REVIEW",
        "reason": "Declared UNKNOWN handling for the reference Consumer."
      },
      "NEEDS_INPUT": {
        "action": "WAIT",
        "reason": "Declared NEEDS_INPUT handling for the reference Consumer."
      },
      "NEEDS_REVIEW": {
        "action": "REVIEW",
        "reason": "Declared NEEDS_REVIEW handling for the reference Consumer."
      }
    }
  },
  "validation": {
    "profile": "player-fallback-conformance/0.1.0",
    "profileRevision": "0.1.0",
    "casesRef": "test/runner.test.mjs",
    "validator": {
      "id": "xdownload-dis-independent-conformance",
      "version": "0.1.0"
    },
    "requiredCoverage": [
      "positive",
      "negative",
      "boundary"
    ]
  }
}

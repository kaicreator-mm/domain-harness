{
  "schemaVersion": "dis.unit/0.1.0",
  "id": "xdownload.player.recognizer",
  "revision": "1.0.0",
  "role": "recognizer",
  "purpose": "Recognize a supported media player from a bounded page observation and retain match evidence.",
  "scope": {
    "domain": "web-media",
    "appliesTo": [
      "http-or-https-page-observation"
    ],
    "excludes": [
      "encrypted-player-decryption",
      "unsupported-player-families"
    ]
  },
  "owner": "xdownload-demo",
  "authority": "CONTROLLED",
  "qualification": {
    "stage": "CANDIDATE",
    "limitations": [
      "Small demo signature catalog."
    ]
  },
  "input": {
    "schemaRef": "domain/schemas/page-observation.schema.json"
  },
  "output": {
    "schemaRef": "domain/schemas/recognition-result.schema.json"
  },
  "implementation": {
    "strategy": "function",
    "ref": "registry:xdownload.player.recognizer@1.0.0",
    "exposure": "semantic",
    "artifactRef": "src/runner.mjs"
  },
  "evidence": {
    "sources": [
      {
        "sourceId": "player-signature-fixture",
        "kind": "reference",
        "ref": "fixtures/player-signatures.json",
        "claim": "Known markers identify supported player families."
      }
    ],
    "absenceReason": null
  },
  "failure": {
    "supported": [
      "UNKNOWN",
      "AMBIGUOUS",
      "INVALID_INPUT",
      "OUT_OF_SCOPE"
    ],
    "handling": {
      "UNKNOWN": "return-empty-candidate-set",
      "AMBIGUOUS": "return-all-matching-candidates",
      "INVALID_INPUT": "reject",
      "OUT_OF_SCOPE": "reject"
    }
  },
  "validation": {
    "profile": "player-recognition-conformance/0.1.0",
    "casesRef": "test/runner.test.mjs",
    "lastResult": "NOT_RUN"
  }
}

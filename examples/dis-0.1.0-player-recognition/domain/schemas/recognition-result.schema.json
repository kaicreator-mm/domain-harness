{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "candidates",
    "evidence",
    "sourceUrl"
  ],
  "properties": {
    "status": {
      "enum": [
        "recognized",
        "ambiguous",
        "unknown"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "kind",
          "ref",
          "claim"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "kind": {
            "const": "observation"
          },
          "ref": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      }
    },
    "sourceUrl": {
      "type": "string"
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/recognizedValue"
      }
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncertainty": {
      "type": "object"
    }
  },
  "$defs": {
    "recognizedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "status"
      ],
      "properties": {
        "value": {},
        "source": {
          "enum": [
            "USER_CONFIRMED",
            "SYSTEM_OBSERVED",
            "MODEL_INFERRED",
            "DERIVED"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "INFERRED",
            "CANDIDATE",
            "UNKNOWN"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

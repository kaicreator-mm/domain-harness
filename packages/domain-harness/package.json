{
  "name": "@kaicreator/domain-harness",
  "version": "0.11.2",
  "description": "Language-Native DomainHarness SDK — reusable Standard Elements for Node and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-sdk-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@photostructure/sqlite": "2.5.0",
    "xstate": "5.33.2",
    "yaml": "2.9.1"
  }
}

{
  "name": "@kaicreator/domain-harness",
  "version": "0.11.0",
  "description": "Element-First DomainHarness 当前架构模块",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/bundle-sdk-composition.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "prebuild": "node ../../scripts/generate-sdk-composition-types.mjs",
    "pretypecheck": "node ../../scripts/generate-sdk-composition-types.mjs",
    "pretest:typecheck": "node ../../scripts/generate-sdk-composition-types.mjs"
  },
  "dependencies": {
    "@kaicreator/domain-harness-contracts": "0.11.0",
    "@kaicreator/domain-harness-microkernel": "0.11.0",
    "xstate": "5.33.2"
  }
}

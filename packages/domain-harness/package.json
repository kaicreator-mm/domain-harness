{
  "name": "@kaicreator/domain-harness",
  "version": "0.2.0",
  "private": true,
  "description": "Portable DomainHarness Runtime Core and Contract SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/public-v2/index.d.ts",
      "import": "./dist/public-v2/index.js",
      "require": "./dist/public-v2/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.js"
    },
    "./v3": {
      "types": "./dist/public-v3/index.d.ts",
      "import": "./dist/public-v3/index.js",
      "require": "./dist/public-v3/index.js"
    },
    "./v4": {
      "types": "./dist/public-v4/index.d.ts",
      "import": "./dist/public-v4/index.js",
      "require": "./dist/public-v4/index.js"
    },
    "./v7": {
      "types": "./dist/public-v7/index.d.ts",
      "import": "./dist/public-v7/index.js",
      "require": "./dist/public-v7/index.js"
    },
    "./v7/execution": {
      "types": "./dist/public-v7/execution.d.ts",
      "import": "./dist/public-v7/execution.js",
      "require": "./dist/public-v7/execution.js"
    },
    "./v9": {
      "types": "./dist/public-v9/index.d.ts",
      "import": "./dist/public-v9/index.js"
    },
    "./v9/deployment": {
      "types": "./dist/public-v9/deployment.d.ts",
      "import": "./dist/public-v9/deployment.js"
    },
    "./v8": {
      "types": "./dist/public-v8/index.d.ts",
      "import": "./dist/public-v8/index.js",
      "require": "./dist/public-v8/index.js"
    },
    "./v8/host": {
      "types": "./dist/host-v8/index.d.ts",
      "import": "./dist/host-v8/index.js",
      "require": "./dist/host-v8/index.js"
    },
    "./v8/dac": {
      "types": "./dist/public-v8/dac.d.ts",
      "import": "./dist/public-v8/dac.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "npm run build -w @kaicreator/domain-harness-contracts -w @kaicreator/domain-harness-microkernel -w @kaicreator/domain-harness-host-node",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-vendored-dist-assets.mjs",
    "build:legacy-test": "tsc -p tsconfig.legacy-test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:legacy-test && node --import tsx --test \"tests/**/*.test.ts\" && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@kaicreator/domain-harness-contracts": "0.10.2-rc.0",
    "@kaicreator/domain-harness-host-node": "0.10.2-rc.0",
    "@kaicreator/domain-harness-microkernel": "0.10.2-rc.0",
    "ajv": "^8.17.1",
    "json-schema-library": "11.6.2",
    "xstate": "^5.26.0"
  },
  "devDependencies": {
    "jsonata": "^2.2.2",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  }
}

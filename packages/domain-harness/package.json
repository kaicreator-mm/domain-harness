{
  "name": "@kaicreator/domain-harness",
  "version": "0.2.0",
  "description": "Portable DomainHarness Runtime Core and Contract SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/public-v2/index.d.ts",
      "import": "./dist/public-v2/index.js",
      "require": "./dist/public-v2/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:legacy-test": "tsc -p tsconfig.legacy-test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:legacy-test && node --import tsx --test \"tests/**/*.test.ts\" && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "jsonata": "^2.2.2",
    "xstate": "^5.26.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  }
}

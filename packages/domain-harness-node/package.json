{
  "name": "@kaicreator/domain-harness-node",
  "version": "0.2.0",
  "description": "Node host bindings for DomainHarness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "npm run build -w @kaicreator/domain-harness",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @kaicreator/domain-harness",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test tests/store/*.test.ts tests/v3-host/*.test.ts tests/cross-host/*.test.ts"
  },
  "dependencies": {
    "@kaicreator/domain-harness": "0.2.0",
    "better-sqlite3": "^12.0.0"
  }
}

{
  "name": "@kaicreator/domain-harness-compiler",
  "version": "0.2.0",
  "description": "Build-time compiler for DomainHarness Target Compiled Domain Packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v10meta": {
      "types": "./dist/qualified-package/v10meta/index.d.ts",
      "import": "./dist/qualified-package/v10meta/index.js"
    },
    "./payload/business-meta-feedback-v1": "./src/qualified-package/payload/business-meta-feedback-v1.mjs",
    "./payload/sfeature-meta-feedback-v1": "./src/qualified-package/payload/sfeature-meta-feedback-v1.mjs",
    "./payload/kernel-mechanism-v1": "./src/qualified-package/payload/kernel-mechanism-v1.mjs",
    "./payload/standard-sdk-v1": "./src/qualified-package/payload/standard-sdk-v1.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "src/qualified-package/payload/*.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "npm run build -w @kaicreator/domain-harness",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @kaicreator/domain-harness",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jsonata": "^2.2.2",
    "typescript": "^5.8.3",
    "yaml": "^2.0.0"
  },
  "peerDependencies": {
    "@kaicreator/domain-harness": "0.2.0"
  }
}

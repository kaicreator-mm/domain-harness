{
  "name": "@kaicreator/domain-harness-microkernel",
  "version": "0.10.2-rc.0",
  "description": "DomainHarness Microkernel public SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"

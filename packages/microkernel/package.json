{
  "name": "@kaicreator/domain-harness-microkernel",
  "version": "0.11.0",
  "description": "DomainHarness v0.11.0 Microkernel (Boot + KDP + Package System; legacy load facade via ./legacy)",
  "type": "module",
  "main": "./dist/v011/index.js",
  "types": "./dist/v011/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v011/index.d.ts",
      "import": "./dist/v011/index.js"
    },
    "./legacy": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy/host-seam": {
      "types": "./dist/host-seam.d.ts",
      "import": "./dist/host-seam.js"
    },
    "./host-seam": {
      "types": "./dist/host-seam.d.ts",
      "import": "./dist/host-seam.js"
    }
  },
  "files": [
    "dist/v011",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kaicreator/domain-harness-contracts": "0.11.0"
  }
}

{
  "name": "@kaicreator/domain-harness-host-node",
  "version": "0.10.2-rc.0",
  "description": "DomainHarness Node host bindings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./llm/openai": {
      "types": "./dist/llm/providers/openai/client.d.ts",
      "import": "./dist/llm/providers/openai/client.js"
    },
    "./llm/anthropic": {
      "types": "./dist/llm/providers/anthropic/client.d.ts",
      "import": "./dist/llm/providers/anthropic/client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kaicreator/domain-harness-contracts": "0.10.2-rc.0",
    "@kaicreator/domain-harness-microkernel": "0.10.2-rc.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  }
}
